<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <FontFamily x:Key="ShareX.FontFamily.Default">Segoe UI, avares://Avalonia.Fonts.Inter/Assets#Inter</FontFamily>
    <FontFamily x:Key="ShareX.FontFamily.Icon">avares://ShareX.ImageEditor/Assets#lucide</FontFamily>
    <FontFamily x:Key="ShareX.FontFamily.Monospace">Cascadia Mono, Consolas, Courier New, Monospace</FontFamily>
    <x:Double x:Key="ShareX.FontSize.Default">13</x:Double>
    <x:Double x:Key="ShareX.Value.Accent.Foreground.DarkSwitchRatio">1.75</x:Double>

    <!-- Project Colors (Theme Driven) -->
    <!-- Project Colors (Theme Driven) -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="ShareX.Color.Accent.Start">#4FD1C5</Color>
            <Color x:Key="ShareX.Color.Accent.End">#38B2AC</Color>
            <Color x:Key="ShareX.Color.Accent.Foreground">#07122A</Color>
            <Color x:Key="ShareX.Color.Text">#E8EDF8</Color>
            <Color x:Key="ShareX.Color.Text.Secondary">#5A7AAB</Color>
            <Color x:Key="ShareX.Color.Background.Main">#07122A</Color>
            <Color x:Key="ShareX.Color.Background.Panel">#0F2246</Color>
            <Color x:Key="ShareX.Color.Background.Popup">#0A1A38</Color>
            <Color x:Key="ShareX.Color.Background.Toolbar">#0D1E3D</Color>
            <Color x:Key="ShareX.Color.Border">#1A3060</Color>
            <Color x:Key="ShareX.Color.Control.Background">#112550</Color>
            <Color x:Key="ShareX.Color.Control.Background.Hover">#1A3560</Color>
            <Color x:Key="ShareX.Color.Control.Border">#1E3A6E</Color>
            <Color x:Key="ShareX.Color.Separator">#1A3060</Color>

            <LinearGradientBrush x:Key="ShareX.Brush.Accent" StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#4FD1C5" Offset="0" />
                <GradientStop Color="#38B2AC" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="ShareX.Brush.Accent.Foreground" Color="#07122A" />
            <SolidColorBrush x:Key="ShareX.Brush.Text" Color="#E8EDF8" />
            <SolidColorBrush x:Key="ShareX.Brush.Text.Secondary" Color="#5A7AAB" />
            <SolidColorBrush x:Key="ShareX.Brush.Background.Main" Color="#07122A" />
            <SolidColorBrush x:Key="ShareX.Brush.Background.Panel" Color="#0F2246" />
            <SolidColorBrush x:Key="ShareX.Brush.Background.Popup" Color="#0A1A38" />
            <SolidColorBrush x:Key="ShareX.Brush.Background.Toolbar" Color="#0D1E3D" />
            <SolidColorBrush x:Key="ShareX.Brush.Border" Color="#1A3060" />
            <SolidColorBrush x:Key="ShareX.Brush.Control.Background" Color="#112550" />
            <SolidColorBrush x:Key="ShareX.Brush.Control.Background.Hover" Color="#1A3560" />
            <SolidColorBrush x:Key="ShareX.Brush.Control.Border" Color="#1E3A6E" />
            <SolidColorBrush x:Key="ShareX.Brush.Separator" Color="#1A3060" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <Color x:Key="ShareX.Color.Accent.Start">#2C7A7B</Color>
            <Color x:Key="ShareX.Color.Accent.End">#285E61</Color>
            <Color x:Key="ShareX.Color.Accent.Foreground">#FFFFFF</Color>
            <Color x:Key="ShareX.Color.Text">#1A202C</Color>
            <Color x:Key="ShareX.Color.Text.Secondary">#718096</Color>
            <Color x:Key="ShareX.Color.Background.Main">#F0F2F5</Color>
            <Color x:Key="ShareX.Color.Background.Panel">#FFFFFF</Color>
            <Color x:Key="ShareX.Color.Background.Popup">#F8FAFC</Color>
            <Color x:Key="ShareX.Color.Background.Toolbar">#EDF2F7</Color>
            <Color x:Key="ShareX.Color.Border">#E2E8F0</Color>
            <Color x:Key="ShareX.Color.Control.Background">#EDF2F7</Color>
            <Color x:Key="ShareX.Color.Control.Background.Hover">#E2E8F0</Color>
            <Color x:Key="ShareX.Color.Control.Border">#CBD5E0</Color>
            <Color x:Key="ShareX.Color.Separator">#E2E8F0</Color>

            <LinearGradientBrush x:Key="ShareX.Brush.Accent" StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#2C7A7B" Offset="0" />
                <GradientStop Color="#285E61" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="ShareX.Brush.Accent.Foreground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ShareX.Brush.Text" Color="#1A202C" />
            <SolidColorBrush x:Key="ShareX.Brush.Text.Secondary" Color="#718096" />
            <SolidColorBrush x:Key="ShareX.Brush.Background.Main" Color="#F0F2F5" />
            <SolidColorBrush x:Key="ShareX.Brush.Background.Panel" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ShareX.Brush.Background.Popup" Color="#F8FAFC" />
            <SolidColorBrush x:Key="ShareX.Brush.Background.Toolbar" Color="#EDF2F7" />
            <SolidColorBrush x:Key="ShareX.Brush.Border" Color="#E2E8F0" />
            <SolidColorBrush x:Key="ShareX.Brush.Control.Background" Color="#EDF2F7" />
            <SolidColorBrush x:Key="ShareX.Brush.Control.Background.Hover" Color="#E2E8F0" />
            <SolidColorBrush x:Key="ShareX.Brush.Control.Border" Color="#CBD5E0" />
            <SolidColorBrush x:Key="ShareX.Brush.Separator" Color="#E2E8F0" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <SolidColorBrush x:Key="ShareX.Brush.Overlay.Soft" Color="#30000000" />
    <SolidColorBrush x:Key="ShareX.Brush.Overlay.Modal" Color="#80000000" />

    <!-- Checkered Pattern (Navy tone) -->
    <DrawingBrush x:Key="ShareX.Brush.Checkered" TileMode="Tile" SourceRect="0,0,30,30" DestinationRect="0,0,30,30">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#07122A">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,30,30" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#0F2246">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="0,0,15,15" />
                            <RectangleGeometry Rect="15,15,15,15" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <DrawingBrush x:Key="ShareX.Brush.Checkered.Small" TileMode="Tile" SourceRect="0,0,8,8" DestinationRect="0,0,8,8">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#07122A">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,8,8" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#0F2246">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="0,0,4,4" />
                            <RectangleGeometry Rect="4,4,4,4" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

</ResourceDictionary>
