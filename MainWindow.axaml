<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BugCapture"
        xmlns:models="clr-namespace:BugCapture.Models"
        xmlns:editor="clr-namespace:ShareX.ImageEditor.Presentation.Views;assembly=ShareX.ImageEditor"
        x:Class="BugCapture.MainWindow"
        x:DataType="local:MainWindow"
        Title="{Binding BugTitle, StringFormat='{}BugCapture - {0}', FallbackValue='BugCapture'}"
        Icon="/Assets/app_icon.png"
        Width="1300" Height="860"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="Full"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        ExtendClientAreaChromeHints="NoChrome"
        Background="{DynamicResource BgBrush}">

    <Window.Styles>

        <!-- ── Dashboard card ── -->
        <Style Selector="Border.dash-card">
            <Setter Property="Background"       Value="{DynamicResource CardBrush}" />
            <Setter Property="BorderBrush"      Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness"  Value="1" />
            <Setter Property="CornerRadius"     Value="0" />
            <Setter Property="Padding"          Value="14,12" />
        </Style>

        <!-- ── Section label (upper-left of each card) ── -->
        <Style Selector="TextBlock.card-label">
            <Setter Property="FontSize"     Value="10" />
            <Setter Property="FontWeight"   Value="SemiBold" />
            <Setter Property="Foreground"   Value="{DynamicResource MutedBrush}" />
            <Setter Property="Margin"       Value="0,0,0,8" />
            <Setter Property="LetterSpacing" Value="1.4" />
        </Style>

        <!-- ── Field label ── -->
        <Style Selector="TextBlock.field-label">
            <Setter Property="FontSize"     Value="10" />
            <Setter Property="FontWeight"   Value="SemiBold" />
            <Setter Property="Foreground"   Value="#5A7AAB" />
            <Setter Property="Margin"       Value="0,0,0,5" />
            <Setter Property="LetterSpacing" Value="1" />
        </Style>

        <!-- ── TextBox dark style ── -->
        <Style Selector="TextBox">
            <Setter Property="Background"   Value="{DynamicResource BgBrush}" />
            <Setter Property="BorderBrush"  Value="{DynamicResource BorderBrush}" />
            <Setter Property="Foreground"   Value="{DynamicResource TextBrush}" />
            <Setter Property="CaretBrush"   Value="{DynamicResource AccentBrush}" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding"      Value="10,6" />
            <Setter Property="FontSize"     Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        
        <!-- ── Title Bar Editor ── -->
        <Style Selector="TextBox.title-bar-editor">
            <Setter Property="Background"   Value="#1A1A1A" />
            <Setter Property="BorderBrush"  Value="#333333" />
            <Setter Property="FontSize"     Value="12" />
            <Setter Property="Height"       Value="28" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBox.title-bar-editor:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Background" Value="#1A1A1A" />
        </Style>

        <!-- ── Toolbar button dark ── -->
        <Style Selector="Button.dash-btn">
            <Setter Property="Background"       Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush"      Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness"  Value="1" />
            <Setter Property="CornerRadius"     Value="0" />
            <Setter Property="Padding"          Value="14,7" />
            <Setter Property="FontSize"         Value="12" />
            <Setter Property="FontWeight"       Value="Medium" />
            <Setter Property="Foreground"       Value="{DynamicResource TextBrush}" />
        </Style>
        <Style Selector="Button.dash-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="Button.dash-btn:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>

        <!-- ── Window control buttons (minimize / close) ── -->
        <Style Selector="Button.wnd-btn">
            <Setter Property="Background"       Value="Transparent" />
            <Setter Property="BorderThickness"  Value="0" />
            <Setter Property="CornerRadius"     Value="0" />
            <Setter Property="Padding"          Value="0" />
            <Setter Property="Width"            Value="40" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Foreground"       Value="{DynamicResource MutedBrush}" />
        </Style>
        <Style Selector="Button.wnd-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
        </Style>
        <Style Selector="Button.wnd-btn.close-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#8B1A1A" />
        </Style>
        <Style Selector="Button.wnd-btn:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#0D2040" />
        </Style>

        <!-- ── Toggle button dark ── -->
        <Style Selector="ToggleButton.dash-toggle">
            <Setter Property="Background"       Value="#112550" />
            <Setter Property="BorderBrush"      Value="#1E3A6E" />
            <Setter Property="BorderThickness"  Value="1" />
            <Setter Property="CornerRadius"     Value="0" />
            <Setter Property="Padding"          Value="14,7" />
            <Setter Property="FontSize"         Value="12" />
            <Setter Property="FontWeight"       Value="Medium" />
            <Setter Property="Foreground"       Value="#5A7AAB" />
        </Style>
        <Style Selector="ToggleButton.dash-toggle:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="#0D2D4A" />
        </Style>
        <Style Selector="ToggleButton.dash-toggle:checked">
            <Setter Property="Foreground"  Value="#4FD1C5" />
            <Setter Property="BorderBrush" Value="#4FD1C5" />
        </Style>
        <Style Selector="ToggleButton.dash-toggle:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1A3560" />
        </Style>

        <!-- ── Thumbnail border (dark) ── -->
        <Style Selector="Border.thumb">
            <Setter Property="BorderBrush"     Value="#1A3060" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background"      Value="#0A1A38" />
            <Setter Property="CornerRadius"    Value="0" />
        </Style>
        <Style Selector="Border.thumb.selected">
            <Setter Property="BorderBrush"     Value="#4FD1C5" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Background"      Value="#0D2D3A" />
        </Style>

        <!-- ── Pulse dot animation ── -->
        <Style Selector="Ellipse.pulse-dot">
            <Style.Animations>
                <Animation Duration="0:0:2" IterationCount="INFINITE">
                    <KeyFrame Cue="0%">  <Setter Property="Opacity" Value="1.0" /></KeyFrame>
                    <KeyFrame Cue="50%"> <Setter Property="Opacity" Value="0.25" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1.0" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- ── Window Border Highlight ── -->
        <Style Selector="Window[IsActive=True] Border#MainWindowBorder">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BoxShadow" Value="0 0 15 2 #4FD1C5" />
        </Style>
        <Style Selector="Window[IsActive=False] Border#MainWindowBorder">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BoxShadow" Value="0 0 0 0 Transparent" />
        </Style>

        <Style Selector="Border.gallery-sidebar">
            <Setter Property="Width" Value="130" />
            <Setter Property="Grid.ColumnSpan" Value="1" />
        </Style>
        <Style Selector="Border.gallery-sidebar.full-width">
            <Setter Property="Width" Value="{x:Static x:Double.NaN}" />
            <Setter Property="Grid.ColumnSpan" Value="2" />
        </Style>

    </Window.Styles>

    <!-- ════════════════ ROOT LAYOUT ════════════════ -->
    <Border x:Name="MainWindowBorder" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
        <Grid RowDefinitions="Auto,*,Auto">

        <!-- ╔══════════════ TOPBAR ══════════════╗ -->
        <Border Grid.Row="0"
                Background="#1e1e1e"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="16,0,0,0"
                DragDrop.AllowDrop="False">
            <Grid x:Name="TopBar"
                  Background="Transparent"
                  PointerPressed="OnTopBarPointerPressed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: pulsing status dot + app name -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10"
                            VerticalAlignment="Center" Margin="0,4,16,4">
                    <Ellipse Classes="pulse-dot"
                             Width="8" Height="8"
                             Fill="{DynamicResource AccentBrush}" />
                    <PathIcon Data="{StaticResource Icon.Bug}" Width="16" Height="16" Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Text="BUGCAPTURE"
                               FontSize="11" FontWeight="Bold"
                               LetterSpacing="2"
                               Foreground="{DynamicResource AccentBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <Border Grid.Column="1" />

                <!-- Right: live date/time  +  Minimize / Close -->
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            VerticalAlignment="Stretch" Spacing="0">

                    <!-- Theme Toggle -->
                    <Button Classes="wnd-btn"
                            ToolTip.Tip="Chuyển chế độ Sáng/Tối"
                            Click="OnToggleThemeClick">
                        <PathIcon Data="{Binding ThemeIcon, Converter={x:Null}}" Width="14" Height="14" Foreground="#9CB3D9" />
                    </Button>

                    <!-- DateTime label -->
                    <TextBlock Text="{Binding CurrentDateTime}"
                               FontSize="11" FontWeight="Medium"
                               LetterSpacing="0.5"
                               Foreground="#9CB3D9"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />

                    <!-- Minimize -->
                    <Button Classes="wnd-btn"
                            ToolTip.Tip="Thu nhỏ"
                            Click="OnMinimizeClick">
                        <PathIcon Data="{StaticResource Icon.Minimize}" Width="12" Height="12" Foreground="#5A7AAB" />
                    </Button>

                    <!-- Maximize -->
                    <Button Classes="wnd-btn"
                            ToolTip.Tip="Phóng to / Thu nhỏ"
                            Click="OnMaximizeClick">
                        <PathIcon Data="{StaticResource Icon.Maximize}" Width="11" Height="11" Foreground="#5A7AAB" />
                    </Button>

                    <!-- Close -->
                    <Button Classes="wnd-btn close-btn"
                            ToolTip.Tip="Đóng"
                            Click="OnCloseClick">
                        <PathIcon Data="{StaticResource Icon.Close}" Width="10" Height="10" Foreground="#C87070" />
                    </Button>

                </StackPanel>

            </Grid>
        </Border>

        <!-- ╔══════════════ MAIN CONTENT ══════════════╗ -->
        <Grid Grid.Row="1" RowDefinitions="Auto,*" Margin="12,10,12,10">

            <!-- ── Row 0: Bug Description ── -->
            <Grid Grid.Row="0" Margin="12,10,12,15" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                <!-- Title Row -->
                <TextBlock Grid.Row="0" Grid.Column="0" Classes="card-label" Text="TIÊU ĐỀ" Width="100" Margin="0,0,12,10" VerticalAlignment="Center" />
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding BugTitle}"
                         Height="32" Margin="0,0,0,10" VerticalAlignment="Center"
                         Watermark="Nhập tiêu đề bug tại đây..." />

                <!-- Description Row -->
                <TextBlock Grid.Row="1" Grid.Column="0" Classes="card-label" Text="MÔ TẢ BUG" Width="100" Margin="0,4,12,10" VerticalAlignment="Top" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding BugDescription}"
                         AcceptsReturn="True" TextWrapping="Wrap" Height="60" Margin="0,0,0,10" 
                         VerticalAlignment="Top" VerticalContentAlignment="Top"
                         Watermark="Mô tả chi tiết: bước tái hiện, kết quả mong đợi, kết quả thực tế..." />

                <!-- Redmine Settings Row -->
                <Expander Grid.Row="2" Grid.Column="1" Header="REDMINE CONFIG" Background="{DynamicResource SurfaceBrush}" Margin="0,0,0,10" Padding="10,5">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="100,*">
                            <TextBlock Grid.Column="0" Classes="card-label" Text="REDMINE URL" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding RedmineUrl}" Height="28" FontSize="11" Watermark="http://localhost:3000/" />
                        </Grid>
                        <Grid ColumnDefinitions="100,*,Auto">
                            <TextBlock Grid.Column="0" Classes="card-label" Text="API KEY" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding RedmineApiKey}" Height="28" FontSize="11" PasswordChar="*" />
                            <Button Grid.Column="2" Content="Re-Connect" Classes="dash-btn" Click="OnRefreshRedmineClick" Margin="10,0,0,0" Height="28" Padding="10,0" />
                        </Grid>
                    </StackPanel>
                </Expander>

                <!-- Project & Tracker Selection -->
                <Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="*,12,*">
                    <Grid Grid.Column="0" ColumnDefinitions="80,*">
                        <TextBlock Grid.Column="0" Classes="card-label" Text="PROJECT" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch" 
                                  Height="32" FontSize="12" Padding="8,4" 
                                  BorderThickness="0" CornerRadius="0"
                                  Background="{DynamicResource SurfaceBrush}"
                                  ItemsSource="{Binding Projects}"
                                  SelectedItem="{Binding SelectedProject}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                    
                    <Grid Grid.Column="2" ColumnDefinitions="80,*">
                        <TextBlock Grid.Column="0" Classes="card-label" Text="TRACKER" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch" 
                                  Height="32" FontSize="12" Padding="8,4" 
                                  BorderThickness="0" CornerRadius="0"
                                  Background="{DynamicResource SurfaceBrush}"
                                  ItemsSource="{Binding Trackers}"
                                  SelectedItem="{Binding SelectedTracker}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                </Grid>

                <!-- Dynamic Custom Fields -->
                <ItemsControl Grid.Row="4" Grid.Column="1" ItemsSource="{Binding CustomFieldControls}" Margin="0,10,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" ItemWidth="400" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:CustomFieldControlViewModel">
                            <Grid ColumnDefinitions="80,*" Margin="0,5,20,5">
                                <TextBlock Grid.Column="0" Classes="card-label" Text="{Binding Field.Name, Converter={x:Null}}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                
                                <Panel Grid.Column="1">
                                    <!-- List Template -->
                                    <ComboBox IsVisible="{Binding IsList}" 
                                              ItemsSource="{Binding Field.PossibleValues}"
                                              SelectedItem="{Binding Value}"
                                              HorizontalAlignment="Stretch" Height="32"
                                              Background="{DynamicResource SurfaceBrush}" BorderThickness="0">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Label}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    
                                    <!-- Text Template -->
                                    <TextBox IsVisible="{Binding IsText}" 
                                             Text="{Binding Value}" 
                                             Height="32" Padding="8,4" FontSize="12" />
                                </Panel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <!-- ── Row 1: Split Gallery & Editor ── -->
            <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="0">
                
                <!-- Left: Image Gallery (Dynamic Orientation) -->
                <Border Grid.Column="0" 
                        Classes="dash-card gallery-sidebar" 
                        Classes.full-width="{Binding !IsEditorVisible}"
                        MinHeight="120"
                        Margin="0,0,0,0" Padding="12">
                    <Panel>
                        <!-- 1. VERTICAL LAYOUT (Sidebar Mode) -->
                        <Grid RowDefinitions="Auto,*" IsVisible="{Binding IsEditorVisible}">
                            <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,12">
                                <Button Classes="dash-btn" Click="OnCaptureRegionClick" Padding="4" Height="44" Width="100">
                                    <StackPanel Orientation="Vertical" Spacing="2" HorizontalAlignment="Center">
                                        <PathIcon Data="{StaticResource Icon.Camera}" Width="18" Height="18" HorizontalAlignment="Center" />
                                        <TextBlock Text="Capture" FontSize="10" HorizontalAlignment="Center" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="dash-btn" Click="OnCaptureScrollClick" Padding="4" Height="44" Width="100">
                                    <StackPanel Orientation="Vertical" Spacing="2" HorizontalAlignment="Center">
                                        <PathIcon Data="{StaticResource Icon.Scroll}" Width="18" Height="18" HorizontalAlignment="Center" />
                                        <TextBlock Text="Scroll" FontSize="10" HorizontalAlignment="Center" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                                <ToggleButton Classes="dash-toggle" IsChecked="{Binding IsEditorVisible, Mode=TwoWay}"
                                              Padding="4" Height="44" Width="100">
                                    <StackPanel Orientation="Vertical" Spacing="2" HorizontalAlignment="Center">
                                        <PathIcon Data="{StaticResource Icon.Edit}" Width="18" Height="18" HorizontalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                                        <TextBlock Text="EditorView" FontSize="10" HorizontalAlignment="Center" FontWeight="SemiBold" />
                                    </StackPanel>
                                </ToggleButton>
                            </StackPanel>
                            
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding CapturedImages}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Vertical" Spacing="8" HorizontalAlignment="Center" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:CapturedImage">
                                            <Button Padding="0" Margin="0" BorderThickness="0" Background="Transparent" Click="OnThumbnailClick" CommandParameter="{Binding}">
                                                <Border Classes="thumb" Classes.selected="{Binding IsSelected}" Padding="3" Width="100" Height="70">
                                                    <Grid>
                                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                                        <Button Classes="close-btn" Click="OnDeleteImageClick" CommandParameter="{Binding}" 
                                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                                Width="18" Height="18" Padding="0">
                                                            <PathIcon Data="{StaticResource Icon.Close}" Width="8" Height="8" />
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <!-- 2. HORIZONTAL LAYOUT (Bottom Bar Mode) -->
                        <ScrollViewer IsVisible="{Binding !IsEditorVisible}" HorizontalScrollBarVisibility="Auto">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <!-- Action Buttons (Stretching) -->
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Stretch">
                                    <Button Classes="dash-btn" Click="OnCaptureRegionClick" Width="80" Margin="0,0,0,0" Padding="8">
                                        <StackPanel VerticalAlignment="Center">
                                            <PathIcon Data="{StaticResource Icon.Camera}" Width="24" Height="24" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                            <TextBlock Text="Capture" FontSize="10" HorizontalAlignment="Center" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="dash-btn" Click="OnCaptureScrollClick" Width="80" Margin="0,0,0,0" Padding="8">
                                        <StackPanel VerticalAlignment="Center">
                                            <PathIcon Data="{StaticResource Icon.Scroll}" Width="24" Height="24" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                            <TextBlock Text="Scroll" FontSize="10" HorizontalAlignment="Center" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                    <ToggleButton Classes="dash-toggle" IsChecked="{Binding IsEditorVisible, Mode=TwoWay}" Width="80" Padding="8">
                                        <StackPanel VerticalAlignment="Center">
                                            <PathIcon Data="{StaticResource Icon.Edit}" Width="24" Height="24" HorizontalAlignment="Center" Margin="0,0,0,4" Foreground="{DynamicResource AccentBrush}"/>
                                            <TextBlock Text="Editor" FontSize="10" HorizontalAlignment="Center" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </ToggleButton>
                                </StackPanel>

                                <!-- Divider -->
                                <Border Width="1" Background="{DynamicResource BorderBrush}" Opacity="0.5" Margin="4,0" />

                                <!-- Horizontal Items List -->
                                <ItemsControl ItemsSource="{Binding CapturedImages}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:CapturedImage">
                                            <Button Padding="0" Margin="0" BorderThickness="0" Background="Transparent" Click="OnThumbnailClick" CommandParameter="{Binding}">
                                                <Border Classes="thumb" Classes.selected="{Binding IsSelected}" Padding="3" Width="100" Height="70">
                                                    <Grid>
                                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                                        <Button Classes="close-btn" Click="OnDeleteImageClick" CommandParameter="{Binding}" 
                                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                                Width="18" Height="18" Padding="0">
                                                            <PathIcon Data="{StaticResource Icon.Close}" Width="8" Height="8" />
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Panel>
                </Border>

                <!-- Right: Image Editor -->
                <Border Grid.Column="1" Classes="dash-card" Padding="0" ClipToBounds="True"
                        BorderThickness="1"
                        IsVisible="{Binding IsEditorVisible}">
                    <editor:EditorView x:Name="EditorViewControl"
                                       DataContext="{Binding EditorViewModel}"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Stretch" />
                </Border>
            </Grid>
        </Grid>

        <!-- ╔══════════════ STATUSBAR ══════════════╗ -->
        <Border Grid.Row="2"
                Background="#1e1e1e"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="16,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusText}"
                           FontSize="11"
                           Foreground="#9cb3d9"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                    <Button Classes="dash-btn" Content="SUBMIT TO REDMINE" 
                            IsEnabled="{Binding !IsSubmitting}"
                            Click="OnSubmitToRedmineClick"
                            Background="{DynamicResource AccentBrush}" Foreground="Black" BorderThickness="0">
                    </Button>
                    <TextBlock Text="BugCapture v1.0 | lam-pt@fujinet.net"
                               FontSize="10"
                               Foreground="#9cb3d9"
                               VerticalAlignment="Center"
                               LetterSpacing="0.5" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════ FULLSCREEN EDITOR OVERLAY ══════════════ -->
        <Grid Grid.Row="0" Grid.RowSpan="3" 
              IsVisible="{Binding EditorViewModel.IsEditorMaximized}"
              Background="{DynamicResource BgBrush}"
              ZIndex="1000">
            <editor:EditorView DataContext="{Binding EditorViewModel}" 
                               HorizontalAlignment="Stretch" 
                               VerticalAlignment="Stretch" />
            
            <!-- Quick exit button for full screen -->
            <Button Command="{Binding EditorViewModel.ToggleEditorMaximizedCommand}"
                    VerticalAlignment="Top" HorizontalAlignment="Right"
                    Classes="wnd-btn" Width="40" Height="40" Margin="10">
                <PathIcon Data="{StaticResource Icon.Close}" Width="14" Height="14" Foreground="{DynamicResource MutedBrush}"/>
            </Button>
        </Grid>

        </Grid>
    </Border>
</Window>
