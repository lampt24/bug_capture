<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BugCapture"
        xmlns:models="clr-namespace:BugCapture.Models"
        xmlns:editor="clr-namespace:ShareX.ImageEditor.Presentation.Views;assembly=ShareX.ImageEditor"
        x:Class="BugCapture.MainWindow"
        x:DataType="local:MainWindow"
        Title="{Binding BugTitle, StringFormat='{}BugCapture - {0}', FallbackValue='BugCapture'}"
        Icon="/Assets/app_icon.png"
        Width="1300" Height="860"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="Full"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        ExtendClientAreaChromeHints="NoChrome"
        Background="{DynamicResource BgBrush}">

	<Window.Styles>

		<!-- ── Dashboard card ── -->
		<Style Selector="Border.dash-card">
			<Setter Property="Background"       Value="{DynamicResource CardBrush}" />
			<Setter Property="BorderBrush"      Value="{DynamicResource BorderBrush}" />
			<Setter Property="BorderThickness"  Value="1" />
			<Setter Property="CornerRadius"     Value="0" />
			<Setter Property="Padding"          Value="14,12" />
		</Style>

		<!-- ── Section label (upper-left of each card) ── -->
		<Style Selector="TextBlock.card-label">
			<Setter Property="FontSize"     Value="12" />
			<Setter Property="FontWeight"   Value="SemiBold" />
			<Setter Property="Foreground"   Value="{DynamicResource MutedBrush}" />
			<Setter Property="Margin"       Value="0" />
			<Setter Property="LetterSpacing" Value="1.4" />
		</Style>

		<!-- ── Field label ── -->
		<Style Selector="TextBlock.field-label">
			<Setter Property="FontSize"     Value="10" />
			<Setter Property="FontWeight"   Value="SemiBold" />
			<Setter Property="Foreground"   Value="#5A7AAB" />
			<Setter Property="Margin"       Value="0,0,0,5" />
			<Setter Property="LetterSpacing" Value="1" />
		</Style>

		<!-- ── TextBox dark style ── -->
		<Style Selector="TextBox">
			<Setter Property="Background"   Value="{DynamicResource BgBrush}" />
			<Setter Property="BorderBrush"  Value="{DynamicResource BorderBrush}" />
			<Setter Property="Foreground"   Value="{DynamicResource TextBrush}" />
			<Setter Property="CaretBrush"   Value="{DynamicResource AccentBrush}" />
			<Setter Property="CornerRadius" Value="0" />
			<Setter Property="Padding"      Value="10,6" />
			<Setter Property="FontSize"     Value="13" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
		</Style>
		<Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
			<Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
		</Style>

		<!-- ── Title Bar Editor ── -->
		<Style Selector="TextBox.title-bar-editor">
			<Setter Property="Background"   Value="#1A1A1A" />
			<Setter Property="BorderBrush"  Value="#333333" />
			<Setter Property="FontSize"     Value="12" />
			<Setter Property="Height"       Value="28" />
			<Setter Property="CornerRadius" Value="4" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
		</Style>
		<Style Selector="TextBox.title-bar-editor:focus /template/ Border#PART_BorderElement">
			<Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
			<Setter Property="Background" Value="#1A1A1A" />
		</Style>

		<!-- ── Toolbar button dark ── -->
		<Style Selector="Button.dash-btn">
			<Setter Property="Background"       Value="{DynamicResource SurfaceBrush}" />
			<Setter Property="BorderBrush"      Value="{DynamicResource BorderBrush}" />
			<Setter Property="BorderThickness"  Value="1" />
			<Setter Property="CornerRadius"     Value="0" />
			<Setter Property="Padding"          Value="14,7" />
			<Setter Property="FontSize"         Value="12" />
			<Setter Property="FontWeight"       Value="Medium" />
			<Setter Property="Foreground"       Value="{DynamicResource TextBrush}" />
			<Setter Property="Cursor"           Value="Hand" />
		</Style>
		<Style Selector="Button.dash-btn:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
			<Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
		</Style>
		<Style Selector="Button.dash-btn:pressed /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
			<Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
		</Style>

		<!-- ── Window control buttons (minimize / close) ── -->
		<Style Selector="Button.wnd-btn">
			<Setter Property="Background"       Value="Transparent" />
			<Setter Property="BorderThickness"  Value="0" />
			<Setter Property="CornerRadius"     Value="0" />
			<Setter Property="Padding"          Value="0" />
			<Setter Property="Width"            Value="40" />
			<Setter Property="VerticalAlignment" Value="Stretch" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
			<Setter Property="HorizontalContentAlignment" Value="Center" />
			<Setter Property="Foreground"       Value="{DynamicResource MutedBrush}" />
			<Setter Property="Cursor"           Value="Hand" />
		</Style>
		<Style Selector="Button.wnd-btn:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="Transparent" />
		</Style>
		<Style Selector="Button.wnd-btn.close-btn:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="Transparent" />
		</Style>
		<Style Selector="Button.wnd-btn:pressed /template/ ContentPresenter">
			<Setter Property="Background" Value="Transparent" />
		</Style>

		<!-- ── Toggle button dark ── -->
		<Style Selector="ToggleButton.dash-toggle">
			<Setter Property="Background"       Value="{DynamicResource SurfaceBrush}" />
			<Setter Property="BorderBrush"      Value="{DynamicResource BorderBrush}" />
			<Setter Property="BorderThickness"  Value="1" />
			<Setter Property="CornerRadius"     Value="0" />
			<Setter Property="Padding"          Value="14,7" />
			<Setter Property="FontSize"         Value="12" />
			<Setter Property="FontWeight"       Value="Medium" />
			<Setter Property="Foreground"       Value="{DynamicResource TextBrush}" />
			<Setter Property="Cursor"           Value="Hand" />
		</Style>
		<Style Selector="ToggleButton.dash-toggle:checked /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource AccentBrush}" />
		</Style>
		<Style Selector="ToggleButton.dash-toggle:checked">
			<Setter Property="Foreground"  Value="Black" />
			<Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
		</Style>
		<Style Selector="ToggleButton.dash-toggle:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
		</Style>

		<!-- ── Thumbnail border (dark) ── -->
		<Style Selector="Border.thumb">
			<Setter Property="BorderBrush"     Value="{DynamicResource BorderBrush}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="Background"      Value="{DynamicResource SurfaceBrush}" />
			<Setter Property="CornerRadius"    Value="0" />
		</Style>
		<Style Selector="Border.thumb.selected">
			<Setter Property="BorderBrush"     Value="{DynamicResource AccentBrush}" />
			<Setter Property="BorderThickness" Value="2" />
			<Setter Property="Background"      Value="{DynamicResource HoverBrush}" />
		</Style>

		<!-- ── Pulse dot animation ── -->
		<Style Selector="Ellipse.pulse-dot">
			<Style.Animations>
				<Animation Duration="0:0:2" IterationCount="INFINITE">
					<KeyFrame Cue="0%">
						<Setter Property="Opacity" Value="1.0" />
					</KeyFrame>
					<KeyFrame Cue="50%">
						<Setter Property="Opacity" Value="0.25" />
					</KeyFrame>
					<KeyFrame Cue="100%">
						<Setter Property="Opacity" Value="1.0" />
					</KeyFrame>
				</Animation>
			</Style.Animations>
		</Style>

		<!-- ── Window Border Highlight ── -->
		<Style Selector="Window[IsActive=True] Border#MainWindowBorder">
			<Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
			<Setter Property="BoxShadow" Value="0 0 15 2 #4FD1C5" />
		</Style>
		<Style Selector="Window[IsActive=False] Border#MainWindowBorder">
			<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
			<Setter Property="BoxShadow" Value="0 0 0 0 Transparent" />
		</Style>

		<Style Selector="Border.gallery-sidebar">
			<Setter Property="Width" Value="130" />
			<Setter Property="Grid.ColumnSpan" Value="1" />
		</Style>
		<Style Selector="Border.gallery-sidebar.full-width">
			<Setter Property="Width" Value="{x:Static x:Double.NaN}" />
			<Setter Property="Grid.ColumnSpan" Value="2" />
		</Style>

	</Window.Styles>

	<!-- ════════════════ ROOT LAYOUT ════════════════ -->
	<Border x:Name="MainWindowBorder" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
		<Grid RowDefinitions="Auto,*,Auto">

			<!-- ╔══════════════ TOPBAR ══════════════╗ -->
			<Border Grid.Row="0"
					Background="#1e1e1e"
					BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
					Padding="16,0,0,0"
					DragDrop.AllowDrop="False">
				<Grid x:Name="TopBar"
					  Background="Transparent"
					  PointerPressed="OnTopBarPointerPressed">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>

					<!-- Left: pulsing status dot + app name -->
					<StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10"
								VerticalAlignment="Center" Margin="0,8,16,8">
						<Ellipse Classes="pulse-dot"
								 Width="8" Height="8"
								 Fill="{DynamicResource AccentBrush}" />
						<PathIcon Data="{StaticResource Icon.Bug}" Width="16" Height="16" Foreground="{DynamicResource AccentBrush}" />
						<TextBlock Text="BUGCAPTURE"
								   FontSize="11" FontWeight="Bold"
								   LetterSpacing="2"
								   Foreground="{DynamicResource AccentBrush}"
								   VerticalAlignment="Center" />
					</StackPanel>

					<Border Grid.Column="1" />

					<!-- Right: live date/time  +  Minimize / Close -->
					<StackPanel Grid.Column="2" Orientation="Horizontal"
								VerticalAlignment="Stretch" Spacing="0">

						<!-- Theme Toggle -->
						<Button Classes="wnd-btn"
								ToolTip.Tip="Chuyển chế độ Sáng/Tối"
								Click="OnToggleThemeClick">
							<PathIcon Data="{Binding ThemeIcon, Converter={x:Null}}" Width="14" Height="14" Foreground="#9CB3D9" />
						</Button>

						<!-- Settings -->
						<Button Classes="wnd-btn"
								ToolTip.Tip="Cài đặt hệ thống"
								Click="OnOpenSettingsClick">
							<PathIcon Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.35 19.43,11.03L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.97 19.05,5.05L16.56,6.05C16.04,5.66 15.47,5.32 14.87,5.07L14.49,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.51,2.42L9.13,5.07C8.53,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.97 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11.03C4.53,11.35 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.95C7.96,18.34 8.53,18.68 9.13,18.93L9.51,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.49,21.58L14.87,18.93C15.47,18.68 16.04,18.34 16.56,17.95L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z" Width="14" Height="14" Foreground="#9CB3D9" />
						</Button>

						<!-- Minimize -->
						<Button Classes="wnd-btn"
								ToolTip.Tip="Thu nhỏ"
								Click="OnMinimizeClick">
							<PathIcon Data="{StaticResource Icon.Minimize}" Width="12" Height="12" Foreground="#5A7AAB" />
						</Button>

						<!-- Maximize -->
						<Button Classes="wnd-btn"
								ToolTip.Tip="Phóng to / Thu nhỏ"
								Click="OnMaximizeClick">
							<PathIcon Data="{StaticResource Icon.Maximize}" Width="11" Height="11" Foreground="#5A7AAB" />
						</Button>

						<!-- Close -->
						<Button Classes="wnd-btn close-btn"
								ToolTip.Tip="Đóng"
								Click="OnCloseClick">
							<PathIcon Data="{StaticResource Icon.Close}" Width="10" Height="10" Foreground="#C87070" />
						</Button>

					</StackPanel>

				</Grid>
			</Border>

			<!-- ╔══════════════ MAIN CONTENT ══════════════╗ -->
			<Grid Grid.Row="1" RowDefinitions="Auto,*" Margin="6">

				<!-- ── Row 0: Bug Description ── -->
				<Grid Grid.Row="0" Margin="0,10,0,15" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
					<!-- Title Row -->
					<TextBlock Grid.Row="0" Grid.Column="0" Classes="card-label" Text="TIÊU ĐỀ" Width="100" Margin="0,0,12,10" VerticalAlignment="Center" />
					<Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="1*,5*" Margin="0,0,0,10">
						<TextBox Grid.Column="0" Text="{Binding BugPrefix}"
								 Height="32" Margin="0,0,10,0" VerticalAlignment="Center"
								 Watermark="Prefix..." />
						<TextBox Grid.Column="1" Text="{Binding BugTitle}"
								 Height="32" VerticalAlignment="Center"
								 Watermark="Nhập tiêu đề bug tại đây..." />
					</Grid>

					<!-- Description Row -->
					<TextBlock Grid.Row="1" Grid.Column="0" Classes="card-label" Text="MÔ TẢ BUG" Width="100" Margin="0,4,12,10" VerticalAlignment="Top" />
					<TextBox Grid.Row="1" Grid.Column="1" Text="{Binding BugDescription}"
							 AcceptsReturn="True" TextWrapping="Wrap" Height="120" Margin="0,0,0,10"
							 VerticalAlignment="Top" VerticalContentAlignment="Top"
							 Watermark="Mô tả chi tiết: bước tái hiện, kết quả mong đợi, kết quả thực tế..." />

					<!-- Combined Redmine Row (Project, Tracker, Assignee) -->
					<TextBlock Grid.Row="2" Grid.Column="0" Classes="card-label" Text="PROJECT" Width="100" Margin="0,0,12,10" VerticalAlignment="Center" />
					<Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,Auto,*,Auto,*" Margin="0,0,0,10">
						<!-- Project -->
						<Grid Grid.Column="0" ColumnDefinitions="*,Auto" Margin="0,0,12,0">
							<ComboBox HorizontalAlignment="Stretch"
									  Height="32" FontSize="12" Padding="8,4"
									  BorderThickness="0" CornerRadius="0"
									  Background="{DynamicResource SurfaceBrush}"
									  ItemsSource="{Binding Projects}"
									  SelectedItem="{Binding SelectedProjectItem}">
								<ComboBox.ItemTemplate>
									<DataTemplate>
												<TextBlock Text="{Binding DisplayName}" />
									</DataTemplate>
								</ComboBox.ItemTemplate>
							</ComboBox>
							<Button Grid.Column="1" Classes="dash-btn" Width="28" Height="32" Margin="4,0,0,0"
									Click="OnRefreshRedmineClick" ToolTip.Tip="Làm mới Redmine">
								<PathIcon Data="M19,12H17.73L19.05,10.68C19.6,10.13 19.6,9.24 19.05,8.69L15.31,4.95C14.76,4.4 13.87,4.4 13.32,4.95L12,6.27V5C12,4.23 11.37,3.6 10.6,3.6H4.4C3.63,3.6 3,4.23 3,5V11C3,11.77 3.63,12.4 4.4,12.4H5.67L4.35,13.72C3.8,14.27 3.8,15.16 4.35,15.71L8.09,19.45C8.64,20 9.53,20 10.08,19.45L11.4,18.13V19.4C11.4,20.17 12.03,20.8 12.8,20.8H19C19.77,20.8 20.4,20.17 20.4,19.4V13.4C20.4,12.63 19.77,12 19,12M6,11V6H10V11H6Z" Width="12" Height="12" />
							</Button>
						</Grid>

						<!-- Tracker -->
						<TextBlock Grid.Column="1" Classes="card-label" Text="TRACKER" VerticalAlignment="Center" Margin="0,0,12,0" />
						<ComboBox Grid.Column="2" HorizontalAlignment="Stretch"
								  Height="32" FontSize="12" Padding="8,4"
								  BorderThickness="0" CornerRadius="0"
								  Background="{DynamicResource SurfaceBrush}"
								  ItemsSource="{Binding Trackers}"
								  IsEnabled="{Binding IsTrackerSelectionEnabled}"
								  SelectedItem="{Binding SelectedTracker}" Margin="0,0,12,0">
							<ComboBox.ItemTemplate>
								<DataTemplate>
									<TextBlock Text="{Binding Name}" />
								</DataTemplate>
							</ComboBox.ItemTemplate>
						</ComboBox>

						<!-- Assignee -->
						<TextBlock Grid.Column="3" Classes="card-label" Text="ASSIGNEE" VerticalAlignment="Center" Margin="0,0,12,0" />
						<ComboBox Grid.Column="4" HorizontalAlignment="Stretch"
								  Height="32" FontSize="12" Padding="8,4"
								  BorderThickness="0" CornerRadius="0"
								  Background="{DynamicResource SurfaceBrush}"
								  ItemsSource="{Binding Memberships}"
								  PlaceholderText="Chọn (Tất cả)"
								  SelectedItem="{Binding SelectedMembership}">
							<ComboBox.ItemTemplate>
								<DataTemplate>
									<TextBlock Text="{Binding User.Name}" />
								</DataTemplate>
							</ComboBox.ItemTemplate>
						</ComboBox>
					</Grid>

					<!-- Dynamic Custom Fields (3 items per row) -->
					<ItemsControl Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" ItemsSource="{Binding CustomFieldControls}" Margin="0,0,0,0">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<UniformGrid Columns="3" />
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="models:CustomFieldControlViewModel">
								<Grid ColumnDefinitions="150,*" Margin="5,5,0,0">
									<TextBlock Grid.Column="0" Classes="card-label" Text="{Binding DisplayName}" 
											   VerticalAlignment="Center" TextWrapping="Wrap" Width="150" Margin="5,0,12,0" />

									<Panel Grid.Column="1">
										<!-- List Template -->
										<ComboBox IsVisible="{Binding IsList}"
												  ItemsSource="{Binding Field.PossibleValues}"
												  SelectedItem="{Binding ListSelectedItem}"
												  HorizontalAlignment="Stretch" Height="32"
												  VerticalAlignment="Center"
												  Background="{DynamicResource SurfaceBrush}" BorderThickness="0">
											<ComboBox.ItemTemplate>
												<DataTemplate>
													<TextBlock Text="{Binding Label}" FontSize="11" />
												</DataTemplate>
											</ComboBox.ItemTemplate>
										</ComboBox>

										<!-- Text Template -->
										<TextBox IsVisible="{Binding IsText}"
												 Text="{Binding Value}"
												 VerticalAlignment="Center"
												 Height="32" FontSize="11" />

										<!-- Number Template -->
										<NumericUpDown IsVisible="{Binding IsNumber}"
													   Value="{Binding NumericValue}"
													   Height="32" FontSize="11"
													   VerticalAlignment="Center" ShowButtonSpinner="False"
													   Background="{DynamicResource SurfaceBrush}" BorderThickness="0" />

										<!-- Date Template -->
										<DatePicker IsVisible="{Binding IsDate}"
													SelectedDate="{Binding DateValue}"
													Height="32" FontSize="11"
													VerticalAlignment="Center"
													Background="{DynamicResource SurfaceBrush}" BorderThickness="0" />

										<!-- Bool Template -->
										<CheckBox IsVisible="{Binding IsBool}"
												  IsChecked="{Binding BoolValue}"
												  VerticalAlignment="Center" />
									</Panel>
								</Grid>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</Grid>

				<!-- ── Row 1: Gallery + Actions Above Editor ── -->
				<Grid Grid.Row="1" RowDefinitions="Auto,Auto,*" Margin="0">
					<!-- Top: Capture Actions (Outside Gallery) -->
					<Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
						<StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
							<Button Classes="dash-btn" Click="OnCaptureRegionClick" Height="42" Padding="12,6,12,6">
								<StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="4">
									<PathIcon Data="{StaticResource Icon.Camera}" Width="18" Height="18" HorizontalAlignment="Center" Margin="0,0,0,2" />
									<TextBlock Text="CAPTURE" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
								</StackPanel>
							</Button>
							<Button Classes="dash-btn" Click="OnCaptureScrollClick" Height="42" Padding="12,6,12,6">
								<StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="4">
									<PathIcon Data="{StaticResource Icon.Scroll}" Width="18" Height="18" HorizontalAlignment="Center" Margin="0,0,0,2" />
									<TextBlock Text="SCROLL CAPTURE" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
								</StackPanel>
							</Button>
							<Button Classes="dash-btn" Click="OnToggleEditorVisibleClick" Height="42" Padding="12,6,12,6">
								<StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="4">
									<PathIcon Data="{StaticResource Icon.Edit}" Width="18" Height="18" HorizontalAlignment="Center" Margin="0,0,0,2" Foreground="{DynamicResource AccentBrush}"/>
									<TextBlock Text="IMAGE EDITOR" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
								</StackPanel>
							</Button>
						</StackPanel>

						<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
							<Button Classes="dash-btn" Content="CREATE ISSUE"
									IsEnabled="{Binding !IsSubmitting}"
									Click="OnSubmitToRedmineClick"
									Height="42"
									VerticalContentAlignment="Center"
									Background="{DynamicResource AccentBrush}" Foreground="Black" BorderThickness="0">
							</Button>
						</StackPanel>
					</Grid>

					<!-- Middle: Thumbnail Gallery -->
					<Border Grid.Row="1"
							Classes="dash-card"
							MinHeight="70"
							Margin="0,0,0,8" Padding="8"
							DragDrop.AllowDrop="True"
							DragDrop.DragOver="OnGalleryDragOver"
							DragDrop.Drop="OnGalleryDrop">
						<ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
							<StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
								<Button Classes="dash-btn" Width="100" Height="60" Click="OnAddAttachmentClick"
										ToolTip.Tip="Add file attachment">
									<StackPanel Orientation="Vertical" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
										<PathIcon Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" Width="18" Height="18" />
										<TextBlock Text="Add" FontSize="11" HorizontalAlignment="Center" />
									</StackPanel>
								</Button>

								<ItemsControl ItemsSource="{Binding CapturedImages}">
									<ItemsControl.ItemsPanel>
										<ItemsPanelTemplate>
											<StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" />
										</ItemsPanelTemplate>
									</ItemsControl.ItemsPanel>
									<ItemsControl.ItemTemplate>
										<DataTemplate x:DataType="models:CapturedImage">
											<Button Padding="0" Margin="0" BorderThickness="0" Background="Transparent"
													Click="OnThumbnailClick" CommandParameter="{Binding}"
													PointerPressed="OnThumbnailPointerPressed"
													PointerMoved="OnThumbnailPointerMoved"
													DragDrop.AllowDrop="True"
													DragDrop.DragOver="OnThumbnailDragOver"
													DragDrop.Drop="OnThumbnailDrop">
												<Border Classes="thumb" Classes.selected="{Binding IsSelected}" Padding="3" Width="100" Height="60">
													<Grid>
														<Image Source="{Binding Thumbnail}" Stretch="UniformToFill" IsVisible="{Binding IsImage}" />
														<StackPanel IsVisible="{Binding !IsImage}" Spacing="2" HorizontalAlignment="Center" VerticalAlignment="Center">
															<PathIcon Data="{Binding FileTypeIconData}" Width="20" Height="20" />
															<TextBlock Text="{Binding FileExtensionDisplay}" FontSize="9" HorizontalAlignment="Center" />
														</StackPanel>
														<Button Classes="close-btn" Click="OnDeleteImageClick" CommandParameter="{Binding}"
																HorizontalAlignment="Right" VerticalAlignment="Top"
																Width="18" Height="18" Padding="0">
															<PathIcon Data="{StaticResource Icon.Close}" Width="8" Height="8" />
														</Button>
													</Grid>
												</Border>
											</Button>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</StackPanel>
						</ScrollViewer>
					</Border>

					<!-- Bottom: Image Editor -->
					<Border Grid.Row="2" Classes="dash-card" Padding="0" ClipToBounds="True"
							BorderThickness="1"
							IsVisible="{Binding IsEditorVisible}">
						<editor:EditorView x:Name="EditorViewControl"
										   DataContext="{Binding EditorViewModel}"
										   PointerPressed="OnEditorPointerPressed"
										   HorizontalAlignment="Stretch"
										   VerticalAlignment="Stretch" />
					</Border>
				</Grid>
			</Grid>

			<!-- ╔══════════════ STATUSBAR ══════════════╗ -->
			<Border Grid.Row="2"
					Background="#1e1e1e"
					BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
					Padding="6,6">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>

					<TextBlock Text="{Binding StatusText}"
							   FontSize="12"
							   Foreground="#ffffff"
							   VerticalAlignment="Center" />

					<Button Grid.Column="1"
							Background="Transparent"
							BorderThickness="0"
							Padding="0"
							Click="OnOpenLastIssueClick"
							IsVisible="{Binding IsLastCreatedIssueVisible}"
							ToolTip.Tip="Mở issue Redmine vừa tạo">
						<TextBlock Text="{Binding LastCreatedIssueText}"
								   FontSize="12"
								   Foreground="{DynamicResource AccentBrush}"
								   TextDecorations="Underline"
								   VerticalAlignment="Center" />
					</Button>
				</Grid>
			</Border>

			<!-- ══════════════ FULLSCREEN EDITOR OVERLAY ══════════════ -->
			<Grid Grid.Row="0" Grid.RowSpan="3"
				  IsVisible="{Binding EditorViewModel.IsEditorMaximized}"
				  Background="{DynamicResource BgBrush}"
				  ZIndex="1000">
				<editor:EditorView x:Name="FullscreenEditorViewControl"
								   DataContext="{Binding EditorViewModel}"
								   PointerPressed="OnEditorPointerPressed"
								   HorizontalAlignment="Stretch"
								   VerticalAlignment="Stretch" />

				<!-- Quick exit button for full screen -->
				<Button Command="{Binding EditorViewModel.ToggleEditorMaximizedCommand}"
						VerticalAlignment="Top" HorizontalAlignment="Right"
						Classes="wnd-btn" Width="40" Height="40" Margin="10">
					<PathIcon Data="{StaticResource Icon.Close}" Width="14" Height="14" Foreground="{DynamicResource MutedBrush}"/>
				</Button>
			</Grid>

		</Grid>
	</Border>
</Window>
