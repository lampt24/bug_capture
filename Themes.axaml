<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="BgColor">#0F1218</Color>
            <Color x:Key="SurfaceColor">#171C24</Color>
            <Color x:Key="CardColor">#1B212B</Color>
            <Color x:Key="BorderColor">#2A3240</Color>
            <Color x:Key="AccentColor">#4C8DFF</Color>
            <Color x:Key="MutedColor">#95A1B5</Color>
            <Color x:Key="TextColor">#E7ECF5</Color>

            <SolidColorBrush x:Key="BgBrush"      Color="#0F1218" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#171C24" />
            <SolidColorBrush x:Key="CardBrush"    Color="#1B212B" />
            <SolidColorBrush x:Key="BorderBrush"  Color="#2A3240" />
            <SolidColorBrush x:Key="AccentBrush"  Color="#4C8DFF" />
            <SolidColorBrush x:Key="MutedBrush"   Color="#95A1B5" />
            <SolidColorBrush x:Key="TextBrush"    Color="#E7ECF5" />
            
            <!-- Hover/Pressed states -->
            <SolidColorBrush x:Key="HoverBrush"   Color="#242D3A" />
            <SolidColorBrush x:Key="PressedBrush" Color="#2D3746" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <Color x:Key="BgColor">#F4F6FA</Color>
            <Color x:Key="SurfaceColor">#FFFFFF</Color>
            <Color x:Key="CardColor">#FBFCFE</Color>
            <Color x:Key="BorderColor">#626364</Color>
            <Color x:Key="AccentColor">#4C8DFF</Color>
            <Color x:Key="MutedColor">#000000</Color>
            <Color x:Key="TextColor">#1F2530</Color>

            <SolidColorBrush x:Key="BgBrush"      Color="#F4F6FA" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="CardBrush"    Color="#FBFCFE" />
            <SolidColorBrush x:Key="BorderBrush"  Color="#626364" />
            <SolidColorBrush x:Key="AccentBrush"  Color="#4C8DFF" />
            <SolidColorBrush x:Key="MutedBrush"   Color="#000000" />
            <SolidColorBrush x:Key="TextBrush"    Color="#1F2530" />

            <!-- Hover/Pressed states for Light -->
            <SolidColorBrush x:Key="HoverBrush"   Color="#EEF3FF" />
            <SolidColorBrush x:Key="PressedBrush" Color="#E1E9FB" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
